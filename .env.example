# Copy to .env and generate different random values for these two settings.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Automatic news scanning is off until explicitly enabled.
NEWS_AUTO_SCAN_ENABLED=false

# Review-only AI analysis is separate from collection; automatic processing is off.
NEWS_ANALYSIS_ENABLED=false
NEWS_ANALYSIS_API_KEY=
NEWS_ANALYSIS_MODEL=gpt-4.1-mini
NEWS_ANALYSIS_MAX_ATTEMPTS=3
NEWS_ANALYSIS_PER_RUN_CENTS=25
NEWS_ANALYSIS_DAILY_CENTS=500
NEWS_ANALYSIS_INPUT_PRICE=1
NEWS_ANALYSIS_OUTPUT_PRICE=5
